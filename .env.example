# Copy to .env.local for local development. Set the same keys in Vercel → Settings → Environment Variables (Production).

# Required for correct canonical URLs, sitemap, robots, and JSON-LD. Must match your public hostname (no trailing slash).
# If unset locally, code defaults to https://mspllcs.com — production should always set this explicitly.
NEXT_PUBLIC_SITE_URL=https://mspllcs.com
